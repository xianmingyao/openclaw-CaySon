# ==================== 应用配置 ====================
APP_NAME=UFO智能体自动化系统
APP_VERSION=v1.0.0
DEBUG=true

# ==================== LLM 配置 ====================
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=ollama
LLM_MODEL=qwen3-vl:8b-instruct
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_BASE_SECONDS=1
LLM_RETRY_BACKOFF_MAX_SECONDS=8
LLM_RETRY_BACKOFF_JITTER_SECONDS=0.25
LLM_RETRY_TIMEOUT_MULTIPLIER=1.25
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.7
LLM_MAX_TOKENS=2048
LLM_MAX_CONCURRENT_REQUESTS=1
LLM_USE_RESPONSES_API=false
LLM_MAX_LOOP_COUNT=100
LLM_LOOP_INTERVAL_MS=1000
LLM_MAX_IMAGE_LENGTH=5
LLM_MAX_PIXELS=2116800

# ==================== MoE 路由配置 ====================
MOE_ENABLED=true
MOE_SIMPLE_MODEL=qwen3-vl:8b
MOE_COMPLEX_MODEL=qwen3-vl:8b-instruct

# ==================== MySQL 配置 ====================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=jingmai_agent
MYSQL_CHARSET=utf8mb4
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20

# ==================== Redis 配置 ====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50
REDIS_URL=redis://127.0.0.1:6379/0

# ==================== Milvus 配置 ====================
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=jingmai_kb
MILVUS_EMBEDDING_MODEL=nomic-embed-text
MILVUS_DIMENSION=768
MILVUS_INDEX_TYPE=IVF_FLAT
MILVUS_METRIC_TYPE=IP

# ==================== 阿里云 OSS 配置 ====================
OSS_ENABLED=false
OSS_ACCESS_KEY_ID=your_access_key
OSS_ACCESS_KEY_SECRET=your_secret_key
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=jingmai-documents

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FORMAT=%(asctime)s | %(levelname)s | %(name)s:%(funcName)s:%(lineno)d - %(message)s
LOG_ROTATION=500 MB
LOG_RETENTION=10 days

# ==================== 任务配置 ====================
MAX_TASK_STEPS=20
TASK_TIMEOUT=600
MAX_CONCURRENT_TASKS=20

# ==================== RAG 配置 ====================
RAG_TOP_K=5
RAG_USE_RERANK=true
RAG_BM25_WEIGHT=0.3
RAG_DENSE_WEIGHT=0.7
RAG_CHUNK_SIZE=1024
RAG_CHUNK_OVERLAP=100

# ==================== 截图配置 ====================
SCREENSHOT_ENABLED=True
SCREENSHOT_MAX_WIDTH=2400
SCREENSHOT_MAX_HEIGHT=1350
SCREENSHOT_PLAN_MAX_WIDTH=1280
SCREENSHOT_PLAN_MAX_HEIGHT=720
SCREENSHOT_FORMAT=PNG

# ==================== 京麦桌面配置 ====================
JINGMAI_EXECUTABLE=
JINGMAI_LIVE_E2E=1
JINGMAI_PROCESS_KEYWORDS=京麦,jingmai,jdm_,jdwb_,JMWorkStation.exe
JINGMAI_WINDOW_KEYWORDS=京麦,京东,jd_,jingmai

# ==================== 商品上架工作流配置 ====================
IMAGE_OUTPUT_DIR=artifacts/images
IMAGE_MAIN_SIZE=1440
IMAGE_MAX_MAIN_COUNT=10
IMAGE_MIN_MAIN_COUNT=3
WORKFLOW_CHECKPOINT_DIR=artifacts/checkpoints
WORKFLOW_DEFAULT_DRY_RUN=true
JD_USE_PLAYWRIGHT=false
JD_PLAYWRIGHT_FALLBACK=true

# ==================== v2 jm_ufo_agent 配置 ====================
JINGMAI_MYSQL_HOST=127.0.0.1
JINGMAI_MYSQL_PORT=3306
JINGMAI_MYSQL_USER=<set-me>
JINGMAI_MYSQL_PASSWORD=<set-me>
JINGMAI_MYSQL_DB=jingmai_agent
JINGMAI_MYSQL_CHARSET=utf8mb4
JINGMAI_MYSQL_MIN_SIZE=1
JINGMAI_MYSQL_MAX_SIZE=5

JINGMAI_REDIS_HOST=127.0.0.1
JINGMAI_REDIS_PORT=6379
JINGMAI_REDIS_PASSWORD=
JINGMAI_REDIS_DB=0
JINGMAI_REDIS_LOCK_TTL_SEC=600

JINGMAI_MILVUS_HOST=127.0.0.1
JINGMAI_MILVUS_PORT=19530
JINGMAI_MILVUS_DB=jingmai_kb
JINGMAI_MILVUS_COLLECTION=jingmai_experience
JINGMAI_MILVUS_DIMENSION=768

JINGMAI_LLM_PROVIDER=ollama
JINGMAI_LLM_BASE_URL=http://localhost:11434
JINGMAI_LLM_API_KEY=ollama
JINGMAI_LLM_MODEL=qwen3-vl:8b-instruct
JINGMAI_LLM_TIMEOUT_SEC=60
JINGMAI_LLM_MAX_RETRIES=3
JINGMAI_FORM_COMPLETION_THRESHOLD=0.90

JINGMAI_REVIEW_SCORER_PROVIDER=minimax
JINGMAI_REVIEW_SCORER_BASE_URL=https://api.minimax.io/v1
JINGMAI_REVIEW_SCORER_API_KEY=<set-me>
JINGMAI_REVIEW_SCORER_MODEL=MiniMax-M3
JINGMAI_REVIEW_SCORER_THINKING=adaptive
JINGMAI_REVIEW_SCORER_MAX_LOOP_STEPS=3
JINGMAI_REVIEW_SCORER_MAX_CALL_ATTEMPTS=5
JINGMAI_REVIEW_SCORER_BACKOFF_BASE_SEC=1
JINGMAI_REVIEW_SCORER_BACKOFF_MAX_SEC=60

JINGMAI_ARTIFACT_DIR=artifacts
JINGMAI_TEMP_DIR=tmp
